<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{{ personal.name }} - Resume</title>
  <link rel="stylesheet" href="resume.css">
</head>
<body>
  <div class="resume-container">
    <header class="header">
      <h1 class="name">{{ personal.name|upper }}</h1>
      <div class="title-sub">Computer Science Undergraduate</div>
      <div class="contact">
        <span>{{ personal.email }}</span> |
        <span>{{ personal.phone }}</span> |
        <span>{{ personal.location }}</span> |
        <a href="{{ personal.linkedin }}" target="_blank">linkedin.com/in/contactsaketh</a> |
        <a href="{{ personal.github }}" target="_blank">github.com/Sak3th2004</a>
      </div>
    </header>

    {% if summary %}
    <section class="section">
      <h2 class="section-title">PROFILE SUMMARY</h2>
      <p class="summary-text">{{ summary.summary if summary.summary is defined else summary }}</p>
    </section>
    {% endif %}

    {% if education %}
    <section class="section">
      <h2 class="section-title">EDUCATION</h2>
      {% for edu in education %}
      <div class="entry">
        <div class="entry-header">
          <span class="entry-main"><b>{{ edu.degree }} in {{ edu.field }}</b></span>
          <span class="entry-meta">{{ edu.start }} – {{ edu.end }}</span>
        </div>
        <div class="entry-sub">
          <span>{{ edu.institution }}</span>
          <span class="entry-meta">{{ edu.location }}</span>
        </div>
      </div>
      {% endfor %}
    </section>
    {% endif %}

    {% if experience %}
    <section class="section">
      <h2 class="section-title">INTERNSHIP EXPERIENCE</h2>
      {% for exp in experience %}
      <div class="entry">
        <div class="entry-header">
          <span class="entry-main"><b>{{ exp.title }}</b></span>
          <span class="entry-meta">{{ exp.start }} – {{ exp.end }}</span>
        </div>
        <div class="entry-sub">
          <span><i>{{ exp.company }}</i></span>
          <span class="entry-meta">{{ exp.location }}</span>
        </div>
        <ul class="bullet-list">
          {% for b in exp.bullets %}
          <li>{{ b.text if b.text is defined else b }}</li>
          {% endfor %}
        </ul>
      </div>
      {% endfor %}
    </section>
    {% endif %}

    {% if projects %}
    <section class="section">
      <h2 class="section-title">PROJECTS</h2>
      {% for proj in projects %}
      <div class="entry">
        <div class="entry-header">
          <span class="entry-main"><b>{{ proj.name }}</b> <span class="badge">[GitHub]</span>{% if proj.award %} — <span class="award-text">{{ proj.award }}</span>{% endif %}</span>
        </div>
        {% if proj.tech %}
        <div class="tech-line">
          <i>{{ proj.tech|join(', ') }}</i>
        </div>
        {% endif %}
        <ul class="bullet-list">
          {% for b in proj.bullets %}
          <li>{{ b.text if b.text is defined else b }}</li>
          {% endfor %}
        </ul>
      </div>
      {% endfor %}
    </section>
    {% endif %}

    {% if achievements %}
    <section class="section">
      <h2 class="section-title">ACHIEVEMENTS</h2>
      <ul class="bullet-list">
        {% for ach in achievements %}
        <li>
          <b>{{ ach.title }}</b>{% if ach.description %} — {{ ach.description }}{% endif %}
          {% if ach.links %}
            {% for link in ach.links %}
              <span class="badge">[{{ link }}]</span>
            {% endfor %}
          {% endif %}
        </li>
        {% endfor %}
      </ul>
    </section>
    {% endif %}

    {% if skills %}
    <section class="section">
      <h2 class="section-title">SKILLS</h2>
      <div class="skills-grid">
        {% for cat, items in skills.items() %}
        {% if items and cat != 'source' %}
        <div class="skill-row">
          <b class="skill-cat">
            {%- if cat == 'ai_ml' -%}AI / ML
            {%- elif cat == 'backend' -%}Backend & Web
            {%- elif cat == 'devops' -%}DevOps & Tools
            {%- else -%}{{ cat|replace('_', ' ')|capitalize }}
            {%- endif -%}:
          </b>
          <span class="skill-items">{{ items|join(', ') }}</span>
        </div>
        {% endif %}
        {% endfor %}
      </div>
    </section>
    {% endif %}

    {% if certifications %}
    <section class="section">
      <h2 class="section-title">CERTIFICATIONS</h2>
      <ul class="bullet-list certs-list">
        {% for cert in certifications %}
        <li>{{ cert.name }}{% if cert.issuer %} — {{ cert.issuer }}{% endif %}{% if cert.year %}, {{ cert.year }}{% endif %}</li>
        {% endfor %}
      </ul>
    </section>
    {% endif %}
  </div>
</body>
</html>
